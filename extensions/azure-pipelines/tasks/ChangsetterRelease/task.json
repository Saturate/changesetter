{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "a1b2c3d4-5e6f-7a8b-9c0d-e1f2a3b4c5d6",
  "name": "ChangsetterRelease",
  "friendlyName": "Changesetter Release",
  "description": "Run changesetter release and optionally create version PRs",
  "helpMarkDown": "[Learn more](https://github.com/Saturate/changesetter)",
  "category": "Utility",
  "author": "Saturate",
  "version": {
    "Major": 0,
    "Minor": 1,
    "Patch": 0
  },
  "instanceNameFormat": "Changesetter Release",
  "inputs": [
    {
      "name": "versionPr",
      "type": "boolean",
      "label": "Version PR mode",
      "defaultValue": "false",
      "required": false,
      "helpMarkDown": "Create/update a version PR instead of releasing directly."
    },
    {
      "name": "versionPrTitle",
      "type": "string",
      "label": "Version PR title",
      "defaultValue": "Next Release",
      "required": false,
      "helpMarkDown": "Title for the version PR."
    },
    {
      "name": "version",
      "type": "string",
      "label": "Changesetter version",
      "defaultValue": "latest",
      "required": false,
      "helpMarkDown": "Version of changesetter to install."
    }
  ],
  "outputVariables": [
    { "name": "released", "description": "Whether a release was created (true/false)" },
    { "name": "releases", "description": "JSON array of release objects" },
    { "name": "version", "description": "Released version string" }
  ],
  "execution": {
    "Node20_1": {
      "target": "index.js"
    }
  }
}
